{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dismac/logistics",
    "type": "project",
    "description": "DisTrack — plataforma logística interna de Dismac: despacho, última milla y red logística. Laravel 13 + DDD, fuera del dominio SAP.",
    "keywords": [
        "dismac",
        "logistics",
        "dispatch",
        "laravel",
        "ddd"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.1",
        "filament/filament": "^4.0",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "logistics/access": "^0.1",
        "logistics/capacity": "^0.1",
        "logistics/carriers": "^0.1",
        "logistics/coverage": "^0.1",
        "logistics/execution": "^0.1",
        "logistics/fleet": "^0.1",
        "logistics/fleetops": "^0.1",
        "logistics/inbound": "^0.1",
        "logistics/inventory": "^0.1",
        "logistics/labels": "^0.1",
        "logistics/network": "^0.1",
        "logistics/notifications": "^0.1",
        "logistics/outbox": "^0.1",
        "logistics/planning": "^0.1",
        "logistics/promise": "^0.1",
        "logistics/returns": "^0.1",
        "logistics/sap-connector": "^0.1",
        "logistics/sellerportal": "^0.1",
        "logistics/sellers": "^0.1",
        "logistics/settings": "^0.1",
        "logistics/settlement": "^0.1",
        "logistics/shared": "^0.1",
        "logistics/shipments": "^0.1",
        "logistics/telemetry": "^0.1",
        "logistics/tracking": "^0.1",
        "pragmarx/google2fa-qrcode": "^4.0",
        "pusher/pusher-php-server": "^7.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "hotmeteor/spectator": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5.12"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/logistics/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Logistics\\Capacity\\Database\\Seeders\\": "packages/logistics/capacity/database/seeders/",
            "Logistics\\Execution\\Database\\Seeders\\": "packages/logistics/execution/database/seeders/",
            "Logistics\\Fleet\\Database\\Seeders\\": "packages/logistics/fleet/database/seeders/",
            "Logistics\\Fleet\\Database\\Factories\\": "packages/logistics/fleet/database/factories/",
            "Logistics\\Labels\\Database\\Seeders\\": "packages/logistics/labels/database/seeders/",
            "Logistics\\Labels\\Database\\Factories\\": "packages/logistics/labels/database/factories/",
            "Logistics\\Network\\Database\\Seeders\\": "packages/logistics/network/database/seeders/",
            "Logistics\\Network\\Database\\Factories\\": "packages/logistics/network/database/factories/",
            "Logistics\\Notifications\\Database\\Seeders\\": "packages/logistics/notifications/database/seeders/",
            "Logistics\\Notifications\\Database\\Factories\\": "packages/logistics/notifications/database/factories/",
            "Logistics\\Planning\\Database\\Seeders\\": "packages/logistics/planning/database/seeders/",
            "Logistics\\Planning\\Database\\Factories\\": "packages/logistics/planning/database/factories/",
            "Logistics\\Promise\\Database\\Seeders\\": "packages/logistics/promise/database/seeders/",
            "Logistics\\Promise\\Database\\Factories\\": "packages/logistics/promise/database/factories/",
            "Logistics\\Returns\\Database\\Seeders\\": "packages/logistics/returns/database/seeders/",
            "Logistics\\Returns\\Database\\Factories\\": "packages/logistics/returns/database/factories/",
            "Logistics\\Sellers\\Database\\Seeders\\": "packages/logistics/sellers/database/seeders/",
            "Logistics\\Sellers\\Database\\Factories\\": "packages/logistics/sellers/database/factories/",
            "Logistics\\Inbound\\Database\\Seeders\\": "packages/logistics/inbound/database/seeders/",
            "Logistics\\Inbound\\Database\\Factories\\": "packages/logistics/inbound/database/factories/",
            "Logistics\\Inventory\\Database\\Seeders\\": "packages/logistics/inventory/database/seeders/",
            "Logistics\\Settlement\\Database\\Seeders\\": "packages/logistics/settlement/database/seeders/",
            "Logistics\\Settings\\Database\\Seeders\\": "packages/logistics/settings/database/seeders/",
            "Logistics\\Settings\\Database\\Factories\\": "packages/logistics/settings/database/factories/",
            "Logistics\\Tracking\\Database\\Seeders\\": "packages/logistics/tracking/database/seeders/",
            "Logistics\\Tracking\\Database\\Factories\\": "packages/logistics/tracking/database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Logistics\\Coverage\\Tests\\": "packages/logistics/coverage/tests/",
            "Logistics\\Execution\\Tests\\": "packages/logistics/execution/tests/",
            "Logistics\\Fleet\\Tests\\": "packages/logistics/fleet/tests/",
            "Logistics\\Labels\\Tests\\": "packages/logistics/labels/tests/",
            "Logistics\\Network\\Tests\\": "packages/logistics/network/tests/",
            "Logistics\\Notifications\\Tests\\": "packages/logistics/notifications/tests/",
            "Logistics\\Planning\\Tests\\": "packages/logistics/planning/tests/",
            "Logistics\\Shipments\\Tests\\": "packages/logistics/shipments/tests/",
            "Logistics\\Tracking\\Tests\\": "packages/logistics/tracking/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php ./vendor/bin/pest"
        ],
        "test:unit": "@php ./vendor/bin/pest --testsuite=Unit",
        "test:feature": "@php ./vendor/bin/pest --testsuite=Feature",
        "test:coverage": "@php ./vendor/bin/pest --coverage --min=75",
        "stan": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
        "pint": "@php ./vendor/bin/pint",
        "pint:check": "@php ./vendor/bin/pint --test",
        "lint": [
            "@pint:check",
            "@stan"
        ],
        "ci": [
            "@lint",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "logistics/access",
                "logistics/capacity",
                "logistics/carriers",
                "logistics/coverage",
                "logistics/execution",
                "logistics/fleet",
                "logistics/fleetops",
                "logistics/inbound",
                "logistics/inventory",
                "logistics/labels",
                "logistics/network",
                "logistics/notifications",
                "logistics/outbox",
                "logistics/planning",
                "logistics/promise",
                "logistics/returns",
                "logistics/sap-connector",
                "logistics/sellerportal",
                "logistics/sellers",
                "logistics/settings",
                "logistics/settlement",
                "logistics/shared",
                "logistics/shipments",
                "logistics/telemetry",
                "logistics/tracking"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
