{
    "name": "logistics/compensation",
    "description": "Compensación por problemas de entrega — vales/cupones de un solo uso (plataforma logística Dismac)",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "logistics/shared": "^0.1",
        "logistics/outbox": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Logistics\\Compensation\\": "src/",
            "Logistics\\Compensation\\Database\\Factories\\": "database/factories/",
            "Logistics\\Compensation\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Logistics\\Compensation\\Infrastructure\\Providers\\CompensationServiceProvider"
            ]
        }
    }
}
