APP_NAME="Dismac Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8110

APP_TIMEZONE=America/La_Paz
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Logs estructurados en JSON (canal `json`). En producción conviene
# LOG_STACK=json para que el agregador ingiera una línea JSON por evento.
LOG_JSON_STREAM=php://stderr
# Processor de correlación (request_id). Default: UidProcessor de Monolog.
# Apuntar a una clase propia para propagar un id de extremo a extremo.
LOG_REQUEST_ID_PROCESSOR=

# Sentry (monitoreo de errores/performance). Inerte hasta instalar
# sentry/sentry-laravel; ver docs/observability.md. DSN vacío = desactivado.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_SEND_DEFAULT_PII=false
SENTRY_SAMPLE_RATE=1.0
# Tracing de performance: vacío = apagado. En producción empezar bajo (0.1).
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

# PostgreSQL + PostGIS (servicio `postgres` del docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=logistics
DB_USERNAME=logistics
DB_PASSWORD=logistics

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Colas sobre Valkey/redis (ADR 002: todo I/O externo pasa por el outbox, nunca
# HTTP síncrono en un request). Cuatro colas nombradas, un worker por cola en
# producción (ver .docker/supervisor y docs/deploy.md). `retry_after` debe ser
# mayor que el `--timeout` del worker de cada cola.
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
REDIS_OUTBOX_QUEUE=outbox
REDIS_OUTBOX_RETRY_AFTER=660
REDIS_NOTIFICATIONS_QUEUE=notifications
REDIS_NOTIFICATIONS_RETRY_AFTER=180
REDIS_PLANNING_QUEUE=planning
REDIS_PLANNING_RETRY_AFTER=1260

CACHE_STORE=redis
CACHE_PREFIX=logistics

# Valkey (compatible con Redis)
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Conexión a Postgres vía PgBouncer (pooling de conexiones a escala) ──
# Para enrutar por PgBouncer: DB_HOST=pgbouncer, DB_PORT=6432 y DB_EMULATE_PREPARES=true (transaction
# pooling rompe prepared statements con estado de sesión; PDO los emula interpolando en PHP).
DB_EMULATE_PREPARES=false
DB_PERSISTENT=false
DB_SEARCH_PATH=public
# Conexión DIRECTA a Postgres (sin PgBouncer) para migraciones/DDL: `artisan migrate --database=pgsql_direct`.
DB_DIRECT_HOST=postgres
DB_DIRECT_PORT=5432
DOCKER_PGBOUNCER_PORT=6432

# Separación de DBs en Valkey: colas/locks (0), cache evictable (1), sesiones (2).
REDIS_SESSION_DB=2

# ── Tuning de Postgres (defaults para contenedor ~4GB; ajustar a la RAM real) ──
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_WAL_SIZE=2GB
PG_MIN_WAL_SIZE=512MB
PG_LOG_MIN_DURATION_MS=500

# ── PgBouncer ──
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# ── Valkey: límite de memoria + política (volatile-lru: solo evicta cache con TTL, nunca colas/sesiones) ──
VALKEY_MAXMEMORY=512mb

# ── Backups de Postgres (servicio pg-backup → volumen `backups`; off-site/PITR: ver .docker/backups/README.md) ──
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS=14

# ── Outbox: pump (encola jobs, drenado paralelo) + circuit breaker por destino ──
OUTBOX_PUMP_BATCH=1000
OUTBOX_PUMP_DEFAULT_QUEUE=outbox
OUTBOX_BREAKER_FAILURES=5
OUTBOX_BREAKER_COOLDOWN=30
OUTBOX_BREAKER_WINDOW=60
OUTBOX_LEASE_SECONDS=120

# ── Observabilidad (endpoint /api/metrics Prometheus + slow-query + tracing) ──
# /api/metrics queda OCULTO (404) salvo que se configure token o allowlist de IPs.
METRICS_TOKEN=
METRICS_IP_ALLOWLIST=
SLOW_QUERY_LOG_ENABLED=false
SLOW_QUERY_THRESHOLD_MS=500
SLOW_QUERY_LOG_CHANNEL=json
# Muestreo de trazas de Sentry (requiere instalar sentry/sentry-laravel). Conservador por defecto.
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── CORS (vacío = ningún origen cruzado; nunca `*` en prod). Para la web de clientes, listar orígenes. ──
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=false

# ── Mantenimiento cluster-wide (multi-réplica): usar cache/redis en vez de file ──
# APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# ── Límites de recursos (solo override de prod: -f .docker/compose/docker-compose.prod.yml) ──
# APP_CPU_LIMIT / APP_MEM_LIMIT / PG_MEM_LIMIT / VALKEY_MEM_LIMIT / WORKER_MEM_LIMIT, etc.
# Ver .docker/compose/docker-compose.prod.yml para la lista completa y sus defaults.

# Tuning del pool PHP-FPM (contenedor web). Todas opcionales: sin definir, el entrypoint usa los
# defaults horneados en .docker/php/www.conf. Cálculo de max_children: (RAM_util_MB*0.75)/~96MB por worker.
FPM_PM=dynamic
FPM_MAX_CHILDREN=50
FPM_START_SERVERS=8
FPM_MIN_SPARE=8
FPM_MAX_SPARE=16
FPM_MAX_REQUESTS=1000

# Retención / purga de logs y append-only (comandos logistics:*:prune, dry-run por defecto).
# Ventanas GENEROSAS y configurables; solo podan logs/append-only desechables, nunca datos de negocio.
# Los crons de purga NO están activos por defecto: habilitarlos en routes/console.php con --force.
ACCESS_AUDIT_RETENTION_DAYS=180
OUTBOX_PRUNE_DISPATCHED_DAYS=14
OUTBOX_PRUNE_DEAD_LETTERED_DAYS=90
TELEMETRY_PINGS_RETENTION_DAYS=60
DB_PRUNE_CHUNK=5000
DB_PRUNE_PAUSE_MS=100

# Dedup/caché persistente de geocoding (tabla geocoding_cache): evita repegar a Nominatim por la misma
# dirección. true por defecto; NullGeocoder (sin Nominatim) no se cachea.
SHIPMENTS_GEOCODER_PERSISTENT_CACHE=true

# Email: función nativa de mail del hosting (binario sendmail del sistema), sin SMTP ni catcher.
# En hostings compartidos el binario sendmail ya está disponible; no se gastan recursos en un servicio
# de correo propio. Si algún proveedor exige SMTP, cambiar MAIL_MAILER=smtp y configurar MAIL_HOST/PORT.
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_FROM_ADDRESS="entregas@dismac.com.bo"
MAIL_FROM_NAME="${APP_NAME}"

# Notificaciones al cliente (ADR 006). El push de la app de clientes va por Firebase Cloud Messaging
# (FCM, ver abajo); Telegram, email y SMS por un gateway open-source. Sin estas variables, cada canal
# queda "no configurado" (el relay reintenta/escala); el email sale por el sendmail nativo del host.

# Push (Firebase Cloud Messaging)
# El push de la app (Flutter) se entrega vía FCM. FCM_PROJECT_ID es el id del proyecto Firebase y
# FCM_CREDENTIALS la ruta al service-account.json con las credenciales de la cuenta de servicio
# (nunca se versiona en el repo). FCM_TIMEOUT es el timeout HTTP en segundos del envío a FCM.
FCM_PROJECT_ID=
FCM_CREDENTIALS=storage/app/firebase/service-account.json
FCM_TIMEOUT=10

# Telegram (Bot API, gratis). Token del bot de @BotFather.
TELEGRAM_BOT_TOKEN=

# SMS de respaldo crítico por gateway open-source self-host (android-sms-gateway / Jasmin / Kannel),
# NO un SaaS de pago. Basic auth (android-sms-gateway) o Bearer token según el gateway. 0 = SMS off.
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TOKEN=
NOTIFICATIONS_SMS_SENDER=Dismac
NOTIFICATIONS_SMS_MONTHLY_CAP=2000

# Almacenamiento S3-compatible (POD, checklist, daños, collages, documentos de flota).
# `AWS_ENDPOINT`/`AWS_USE_PATH_STYLE_ENDPOINT` permiten apuntar a MinIO, Cloudflare R2,
# DigitalOcean Spaces, etc.; dejar `AWS_ENDPOINT` vacío usa S3 de AWS.
#
# DESARROLLO: por defecto apuntan al MinIO del docker-compose (servicios `minio` +
# `createbuckets`, que crea el bucket `AWS_BUCKET`). Credenciales de dev minioadmin/minioadmin;
# consola web en http://localhost:9011. Ver docs/deploy.md §5. Para probar el flujo S3 real hay
# que poner FILESYSTEM_DISK=s3 (o los selectores *_DISK de abajo en su disco S3).
# PRODUCCIÓN: reemplazar por las credenciales, región, bucket y endpoint reales (S3/MinIO/R2).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=logistics
AWS_URL=
# Endpoint interno del contenedor MinIO (red docker). Vaciar para usar S3 de AWS.
AWS_ENDPOINT=http://minio:9000
# MinIO/R2/Spaces requieren path-style (bucket en la ruta, no en el subdominio).
AWS_USE_PATH_STYLE_ENDPOINT=true

# Disco nube por defecto. En producción apuntar FILESYSTEM_DISK a 's3' (o al disco
# que corresponda) y dejar los selectores de abajo con su disco dedicado.
FILESYSTEM_CLOUD=s3

# Discos dedicados por tipo de evidencia. Cada uno puede vivir en su propio bucket
# (si se deja vacío, cae a AWS_BUCKET con prefijo de ruta). El ciclo de vida /
# retención de cada bucket está documentado en docs/deploy.md.
#   - pod        prueba de entrega (firma + fotos del repartidor)
#   - checklist  checklist de carga / salida de vehículo
#   - damage     evidencia de daños (reclamos, siniestros)
#   - collages   collage PNG que acompaña la notificación al cliente (público)
AWS_POD_BUCKET=
AWS_CHECKLIST_BUCKET=
AWS_DAMAGE_BUCKET=
AWS_COLLAGE_BUCKET=

# Selectores de disco por contexto (nombre de un disco de config/filesystems.php).
# En desarrollo se pueden dejar en 'public'/'local'; en producción apuntar al disco S3.
EXECUTION_POD_DISK=pod
EXECUTION_CHECKLIST_DISK=checklist
EXECUTION_DAMAGE_DISK=damage
FLEET_DOCUMENTS_DISK=documents
NOTIFICATIONS_COLLAGE_DISK=collages
AWS_DOCUMENTS_BUCKET=

# Firma de etiquetas QR (ADR 004). Generar con: php artisan logistics:labels:keygen
LABELS_ACTIVE_KEY_ID=1
LABELS_SIGNING_KEY=
LABELS_PREVIOUS_PUBLIC_KEYS=

# Ruteo self-host sobre OpenStreetMap (ADR 009). Apuntan a los servicios internos del
# docker-compose (OSRM + VROOM). Requieren el extracto de Bolivia preprocesado: ver
# docs/routing-selfhost.md. Para usar el OSRM demo público en su lugar, comentar OSRM_HOST.
OSRM_HOST=http://osrm:5000
VROOM_URL=http://vroom:3000

# Selector del backend de ruteo: builtin (Clarke-Wright + 2-opt, por defecto) | osrm_trip | vroom.
# 'vroom' solo surte efecto con VROOM_URL definido; si no, cae a builtin.
PLANNING_ROUTING_BACKEND=builtin

# Geocoder OpenStreetMap self-host (Nominatim). Todo open-source: sin Google, sin claves ni cuota de
# pago. Apunta al servicio `nominatim` del docker-compose; shipments le agrega la ruta /search. Requiere
# importar el extracto de Bolivia: ver docs/maps-geocoder-selfhost.md. Vacío/deshabilitado = stub neutro.
NOMINATIM_URL=http://nominatim:8080
# SHIPMENTS_GEOCODER_NOMINATIM_ENABLED=true

# Teselas de mapa OpenStreetMap self-host (servicio `tileserver` del docker-compose). Es la URL que pide
# el NAVEGADOR, por eso usa el puerto del host. Requiere el mbtiles/estilo de Bolivia: ver
# docs/maps-geocoder-selfhost.md. Dejar MAP_TILE_URL vacío fuerza el tile público de OSM (solo demo).
MAP_TILE_URL=http://localhost:8082/styles/osm-bright/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap"
# MAP_TILE_MAX_ZOOM=19

# (Geocoder Nominatim y teselas OpenStreetMap self-host: ya configurados arriba; formalizados en el
# ADR 013 "Todo OpenStreetMap self-host, sin Google ni servicios de pago". Ver docs/opensource-stack.md.)
#
# Nota: el push de la app (FCM), Telegram y el SMS de respaldo ya están configurados arriba, en el
# bloque "Notificaciones al cliente". No hay más variables de push/notificaciones: las claves reales
# que lee el código son FCM_*, TELEGRAM_BOT_TOKEN, SMS_GATEWAY_* y NOTIFICATIONS_SMS_*.

# Conector SAP (ADR 002). Capa anti-corrupción: SAP solo se toca desde el conector, vía outbox. Sin
# SAP_CONNECTOR_BASE_URL el conector cae al stub Null (se puede desarrollar sin SAP). Los secretos van
# aquí / en el gestor de secretos, nunca en el repo.
SAP_CONNECTOR_BASE_URL=
# SAP_CONNECTOR_BASE_URL=https://sap.example.com/odata
SAP_CONNECTOR_USERNAME=
SAP_CONNECTOR_PASSWORD=
# Timeout por request a SAP (segundos); hablar con SAP nunca debe colgar un worker de despacho.
SAP_CONNECTOR_TIMEOUT=10
# Rutas relativas de los recursos SAP (configurables por entorno).
SAP_CONNECTOR_ORDERS_PATH=/orders/pending
SAP_CONNECTOR_STOCK_TRANSFERS_PATH=/stock-transfers
# Centro/almacén por defecto para recepciones que no resuelven por el mapa de materiales (P2-SAP-06).
SAP_CONNECTOR_DEFAULT_CENTER=
SAP_CONNECTOR_DEFAULT_WAREHOUSE=
# SAP_CONNECTOR_DEFAULT_CENTER=1000
# SAP_CONNECTOR_DEFAULT_WAREHOUSE=0001

# Ingesta de pedidos del e-commerce Magento (contexto shipments). Sin SHIPMENTS_MAGENTO_BASE_URL el
# adaptador queda inerte (stub). El access token es un secreto: va aquí / en el gestor de secretos.
SHIPMENTS_MAGENTO_BASE_URL=
# SHIPMENTS_MAGENTO_BASE_URL=https://tienda.example.com/rest/V1
SHIPMENTS_MAGENTO_ACCESS_TOKEN=
# Estado de los pedidos a traer de Magento y tamaño de página del barrido.
SHIPMENTS_MAGENTO_STATUS=processing
SHIPMENTS_MAGENTO_PAGE_SIZE=100
# Timeout por request a Magento (segundos).
SHIPMENTS_MAGENTO_TIMEOUT=10

# API — Idempotencia de escrituras (para la app offline que reintenta). El middleware es no-op en GET
# y sin la cabecera; con ella, guarda la respuesta 2xx y la reproduce ante un reintento con la misma clave.
API_IDEMPOTENCY_HEADER=Idempotency-Key
# Store de cache para las respuestas guardadas; vacío = store por defecto (Valkey).
API_IDEMPOTENCY_STORE=
# Vida de la respuesta guardada, en segundos (24 h).
API_IDEMPOTENCY_TTL=86400
# Longitud máxima aceptada para la clave.
API_IDEMPOTENCY_MAX_KEY_LENGTH=255
# Segundos que un request en vuelo bloquea a otro con la misma clave (evita doble ejecución concurrente).
API_IDEMPOTENCY_LOCK_SECONDS=15

VITE_APP_NAME="${APP_NAME}"
