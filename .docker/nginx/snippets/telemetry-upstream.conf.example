# ============================================================
# telemetry-upstream.conf — rutea el contexto telemetry a su propia unidad de despliegue (Ola 6)
# ============================================================
# Manda /api/v1/app/telemetry/* y /api/v1/integrations/telemetry/* al servicio `telemetry-api`
# (.docker/compose/docker-compose.telemetry-service.yml, APP_SERVICE_ROLE=telemetry). El resto del
# tráfico sigue yendo a `app` como siempre.
#
# Cómo activarlo (opt-in, sin tocar la config versionada):
#   1. Copiar este archivo como `.docker/nginx/snippets/telemetry-upstream.conf`.
#   2. Montarlo en el contenedor de nginx (override de compose):
#        nginx:
#            volumes:
#                - ./.docker/nginx/snippets/telemetry-upstream.conf:/etc/nginx/snippets/telemetry-upstream.conf:ro
#   3. Incluirlo DENTRO del bloque `server { ... }` del vhost, antes de `location / { ... }`:
#        include /etc/nginx/snippets/telemetry-upstream.conf;
#   4. Recargar: `docker compose exec nginx nginx -s reload`.
#
# Requiere el `resolver 127.0.0.11 ...` que el vhost ya declara: el upstream va por VARIABLE para que
# nginx re-resuelva el nombre del servicio. Con `--scale telemetry-api=N` el DNS de Docker devuelve las N
# direcciones y nginx reparte entre ellas (round-robin), además de tolerar que un contenedor se recree.
#
# Se pasa el request directo al front controller (public/index.php) del contenedor de telemetry: no hay
# archivos estáticos bajo estas rutas, así que no hace falta try_files. La lista de parámetros FastCGI va
# completa y explícita (sin `include fastcgi_params`) para no enviar SCRIPT_FILENAME/SCRIPT_NAME duplicados.
# ============================================================

location ~ ^/api/v1/(app|integrations)/telemetry(/|$) {
    set $upstream_telemetry telemetry-api:9000;

    fastcgi_pass $upstream_telemetry;

    fastcgi_param SCRIPT_FILENAME   /var/www/html/public/index.php;
    fastcgi_param SCRIPT_NAME       /index.php;
    fastcgi_param DOCUMENT_ROOT     /var/www/html/public;
    fastcgi_param DOCUMENT_URI      /index.php;
    fastcgi_param REQUEST_URI       $request_uri;
    fastcgi_param QUERY_STRING      $query_string;
    fastcgi_param REQUEST_METHOD    $request_method;
    fastcgi_param CONTENT_TYPE      $content_type;
    fastcgi_param CONTENT_LENGTH    $content_length;
    fastcgi_param SERVER_PROTOCOL   $server_protocol;
    fastcgi_param REQUEST_SCHEME    $scheme;
    fastcgi_param HTTPS             $https if_not_empty;
    fastcgi_param GATEWAY_INTERFACE CGI/1.1;
    fastcgi_param SERVER_SOFTWARE   nginx;
    fastcgi_param REMOTE_ADDR       $remote_addr;
    fastcgi_param REMOTE_PORT       $remote_port;
    fastcgi_param SERVER_ADDR       $server_addr;
    fastcgi_param SERVER_PORT       $server_port;
    fastcgi_param SERVER_NAME       $server_name;
    fastcgi_param REDIRECT_STATUS   200;

    fastcgi_hide_header X-Powered-By;

    # Requests cortos (validar + encolar): timeouts más ajustados que el vhost general. Con el modo
    # `sync` un lote grande puede tardar más; subirlos si se usa ese modo detrás de este upstream.
    fastcgi_connect_timeout 5s;
    fastcgi_read_timeout 30s;
    fastcgi_send_timeout 30s;

    # Un lote de 500 lecturas pesa decenas de KB: alcanza con el cuerpo en memoria.
    client_max_body_size 2M;
    client_body_buffer_size 256k;

    # Si la unidad de telemetry no responde, nginx contesta 502/504 y el app reintenta el lote (la ingesta
    # es idempotente por lectura). Para volver al monolito basta quitar el include y recargar nginx.
}
