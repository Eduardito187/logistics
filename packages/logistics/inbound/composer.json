{
    "name": "logistics/inbound",
    "description": "Inbound — ASN/cita, cupos de andén y recepción (goods receipt + QC) de sellers; plataforma logística Dismac",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "logistics/shared": "^0.1",
        "logistics/outbox": "^0.1",
        "logistics/capacity": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Logistics\\Inbound\\": "src/",
            "Logistics\\Inbound\\Database\\Factories\\": "database/factories/",
            "Logistics\\Inbound\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Logistics\\Inbound\\Infrastructure\\Providers\\InboundServiceProvider"
            ]
        }
    }
}
