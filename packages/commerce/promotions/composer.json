    "description": "Motor de promociones / cupones de comercio (descuentos por canal, condiciones, versionado) — plataforma Dismac",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "logistics/shared": "^0.1",
        "logistics/outbox": "^0.1"
