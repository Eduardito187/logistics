{
    "name": "commerce/catalog",
    "description": "Catálogo / PIM de comercio (producto, variantes, categorías, medios) — plataforma Dismac",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "logistics/shared": "^0.1",
        "logistics/outbox": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Commerce\\Catalog\\": "src/",
            "Commerce\\Catalog\\Database\\Factories\\": "database/factories/",
            "Commerce\\Catalog\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Commerce\\Catalog\\Infrastructure\\Providers\\CatalogServiceProvider"
            ]
        }
    }
}
