{
    "name": "commerce/accounts",
    "description": "Cuentas / identidad comercial de comercio (tipo de cuenta, direcciones, estado) — plataforma Dismac",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "logistics/shared": "^0.1",
        "logistics/outbox": "^0.1"
    },
    "autoload": {
        "psr-4": {
