APP_NAME="Dismac Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8110

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS (servicio `postgres` del docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=logistics
DB_USERNAME=logistics
DB_PASSWORD=logistics

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=logistics

# Valkey (compatible con Redis)
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit en desarrollo (UI: http://localhost:8055)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="entregas@dismac.com.bo"
MAIL_FROM_NAME="${APP_NAME}"

# Almacenamiento S3-compatible (fotos de POD, checklist, daños)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Firma de etiquetas QR (ADR 004). Generar con: php artisan logistics:labels:keygen
LABELS_ACTIVE_KEY_ID=1
LABELS_SIGNING_KEY=
LABELS_PREVIOUS_PUBLIC_KEYS=

VITE_APP_NAME="${APP_NAME}"
