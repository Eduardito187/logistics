# ============================================================
# .gitignore — logistics
# ============================================================

# ---------- Laravel ----------
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
/bootstrap/cache/*.php
!/bootstrap/cache/.gitkeep

# ---------- Env ----------
.env
.env.backup
.env.production
.env.local
auth.json

# ---------- Testing ----------
.phpunit.result.cache
.phpunit.cache/
/tests/coverage/
/tests/coverage.xml
/tests/coverage.html/
# Artefacto SQLite creado en la raíz cuando DB_DATABASE=dismac se filtra a los tests
/logistics_test
/database/*.sqlite

# ---------- Herramientas de calidad ----------
.phpstan.cache/
.php-cs-fixer.cache
.pint.cache
.rr.yaml
.psalm.cache/

# ---------- Herramientas de dev ----------
.homestead/
Homestead.json
Homestead.yaml

# ---------- Docker (bind mount local) ----------
docker-compose.override.yml
.docker/data/

# ---------- IDE ----------
.idea/
.vscode/
!.vscode/settings.json.example
.fleet/
.zed/
*.sublime-project
*.sublime-workspace
nbproject/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Node ----------
npm-debug.log
yarn.lock.rejected
package-lock.json.rejected

# ---------- Backups y temporales ----------
*.bak
*.tmp
*.orig
*.rej

# ---------- Documentos generados ----------
/docs/api/generated/
/docs/coverage/

# Husky se instala vía `npm install` (script `prepare`); su runtime interno no se versiona.
.husky/_
