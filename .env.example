APP_NAME="Dismac Logistics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8110

APP_TIMEZONE=America/La_Paz
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Logs estructurados en JSON (canal `json`). En producción conviene
# LOG_STACK=json para que el agregador ingiera una línea JSON por evento.
LOG_JSON_STREAM=php://stderr
# Processor de correlación (request_id). Default: UidProcessor de Monolog.
# Apuntar a una clase propia para propagar un id de extremo a extremo.
LOG_REQUEST_ID_PROCESSOR=

# Sentry (monitoreo de errores/performance). Inerte hasta instalar
# sentry/sentry-laravel; ver docs/observability.md. DSN vacío = desactivado.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_SEND_DEFAULT_PII=false
SENTRY_SAMPLE_RATE=1.0
# Tracing de performance: vacío = apagado. En producción empezar bajo (0.1).
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

# PostgreSQL + PostGIS (servicio `postgres` del docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=logistics
DB_USERNAME=logistics
DB_PASSWORD=logistics

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Colas sobre Valkey/redis (ADR 002: todo I/O externo pasa por el outbox, nunca
# HTTP síncrono en un request). Cuatro colas nombradas, un worker por cola en
# producción (ver .docker/supervisor y docs/deploy.md). `retry_after` debe ser
# mayor que el `--timeout` del worker de cada cola.
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
REDIS_OUTBOX_QUEUE=outbox
REDIS_OUTBOX_RETRY_AFTER=660
REDIS_NOTIFICATIONS_QUEUE=notifications
REDIS_NOTIFICATIONS_RETRY_AFTER=180
REDIS_PLANNING_QUEUE=planning
REDIS_PLANNING_RETRY_AFTER=1260

CACHE_STORE=redis
CACHE_PREFIX=logistics

# Valkey (compatible con Redis)
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit en desarrollo (UI: http://localhost:8055)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="entregas@dismac.com.bo"
MAIL_FROM_NAME="${APP_NAME}"

# Almacenamiento S3-compatible (POD, checklist, daños, collages).
# `AWS_ENDPOINT`/`AWS_USE_PATH_STYLE_ENDPOINT` permiten apuntar a MinIO, Cloudflare R2,
# DigitalOcean Spaces, etc.; dejar `AWS_ENDPOINT` vacío usa S3 de AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Disco nube por defecto. En producción apuntar FILESYSTEM_DISK a 's3' (o al disco
# que corresponda) y dejar los selectores de abajo con su disco dedicado.
FILESYSTEM_CLOUD=s3

# Discos dedicados por tipo de evidencia. Cada uno puede vivir en su propio bucket
# (si se deja vacío, cae a AWS_BUCKET con prefijo de ruta). El ciclo de vida /
# retención de cada bucket está documentado en docs/deploy.md.
#   - pod        prueba de entrega (firma + fotos del repartidor)
#   - checklist  checklist de carga / salida de vehículo
#   - damage     evidencia de daños (reclamos, siniestros)
#   - collages   collage PNG que acompaña la notificación al cliente (público)
AWS_POD_BUCKET=
AWS_CHECKLIST_BUCKET=
AWS_DAMAGE_BUCKET=
AWS_COLLAGE_BUCKET=

# Selectores de disco por contexto (nombre de un disco de config/filesystems.php).
# En desarrollo se pueden dejar en 'public'/'local'; en producción apuntar al disco S3.
EXECUTION_POD_DISK=pod
EXECUTION_CHECKLIST_DISK=checklist
EXECUTION_DAMAGE_DISK=damage
FLEET_DOCUMENTS_DISK=documents
NOTIFICATIONS_COLLAGE_DISK=collages
AWS_DOCUMENTS_BUCKET=

# Firma de etiquetas QR (ADR 004). Generar con: php artisan logistics:labels:keygen
LABELS_ACTIVE_KEY_ID=1
LABELS_SIGNING_KEY=
LABELS_PREVIOUS_PUBLIC_KEYS=

# Ruteo self-host sobre OpenStreetMap (ADR 009). Apuntan a los servicios internos del
# docker-compose (OSRM + VROOM). Requieren el extracto de Bolivia preprocesado: ver
# docs/routing-selfhost.md. Para usar el OSRM demo público en su lugar, comentar OSRM_HOST.
OSRM_HOST=http://osrm:5000
VROOM_URL=http://vroom:3000

# Selector del backend de ruteo: builtin (Clarke-Wright + 2-opt, por defecto) | osrm_trip | vroom.
# 'vroom' solo surte efecto con VROOM_URL definido; si no, cae a builtin.
PLANNING_ROUTING_BACKEND=builtin

VITE_APP_NAME="${APP_NAME}"
