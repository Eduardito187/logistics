includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - packages/logistics
        - database/factories
        - database/seeders

    excludePaths:
        - packages/*/*/tests/*

    # Mismo nivel que dis-commerce: 8 = máximo antes del inferrable-only 9
    level: 8

    checkModelProperties: true
    checkOctaneCompatibility: true

    # Los handlers CQRS declaran su tipo concreto por genéricos (@implements CommandHandler<X>),
    # así que PHPStan trata los instanceof/asserts de narrowing como "siempre verdaderos". Esos
    # tipos vienen de PHPDoc; desactivamos la certeza de PHPDoc (sugerencia del propio PHPStan)
    # para no exigir asserts redundantes en cada handler. El nivel 8 se mantiene.
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # UserFactory del skeleton usa array<string, mixed> genérico (mismo caso que dis-commerce).
        -
            identifier: method.childReturnType
            path: database/factories/UserFactory.php

        # Las factories de los packages usan el mismo array<string, mixed> genérico que UserFactory:
        # Laravel exige array<model property, mixed> en el padre, que es un falso positivo acá.
        -
            identifier: method.childReturnType
            path: packages/logistics/*/src/Infrastructure/Persistence/Eloquent/Factory/*

        # Los config/ de packages usan env() legítimamente
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: packages/logistics/*/config/*.php

        # Los repos Eloquent devuelven arrays secuenciales (listas en runtime) que PHPStan no puede
        # probar como list<> a partir del tipo que infiere de Eloquent/array_map.
        -
            identifier: return.type
            path: packages/logistics/*/src/Infrastructure/Persistence/Eloquent/*

        # El @var del handler resuelto por el bus no fija el genérico T (se despacha por el registry).
        -
            identifier: missingType.generics
            path: packages/logistics/shared/src/Infrastructure/Bus/*

        # Binding de los buses CQRS: larastan sugiere bind/closure para Octane; el contenedor se
        # reinyecta por request, así que la captura es intencional y segura acá.
        -
            identifier: larastan.octaneCompatibility
            path: packages/logistics/shared/src/Infrastructure/Providers/SharedServiceProvider.php

    reportUnmatchedIgnoredErrors: false

    tmpDir: .phpstan.cache
