{
    "name": "logistics/telemetry",
    "description": "Telemetría GPS de vehículos: ingesta de posiciones, trips, analítica de calles, geocercas y mal uso — plataforma logística Dismac",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "logistics/shared": "^0.1",
        "logistics/outbox": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Logistics\\Telemetry\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Logistics\\Telemetry\\Infrastructure\\Providers\\TelemetryServiceProvider"
            ]
        }
    }
}
